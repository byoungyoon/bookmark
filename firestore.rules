rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidProject(data) {
        return data.keys().hasAll(['id', 'name', 'userId', 'createdAt']) &&
               data.id is string && data.id.size() <= 128 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.userId is string && data.userId == request.auth.uid &&
               data.createdAt is timestamp;
    }

    function isValidBookmark(data) {
        return data.keys().hasAll(['id', 'projectId', 'title', 'url', 'userId', 'createdAt']) &&
               data.id is string && data.id.size() <= 128 &&
               data.projectId is string && data.projectId.size() <= 128 &&
               data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
               data.url is string && data.url.size() > 0 && data.url.size() <= 2000 &&
               data.userId is string && data.userId == request.auth.uid &&
               data.createdAt is timestamp &&
               (!('memo' in data) || (data.memo is string && data.memo.size() <= 1000));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.auth.token.email_verified == true && 
                       isValidId(projectId) && isValidProject(incoming()) && incoming().id == projectId;
      allow update: if isSignedIn() && isValidProject(incoming()) && 
                       existing().userId == request.auth.uid && incoming().userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /bookmarks/{bookmarkId} {
        allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && request.auth.token.email_verified == true && 
                         isValidId(bookmarkId) && isValidBookmark(incoming()) && incoming().id == bookmarkId &&
                         exists(/databases/$(database)/documents/projects/$(projectId)) &&
                         get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
        allow update: if isSignedIn() && 
                         existing().userId == request.auth.uid && incoming().userId == request.auth.uid &&
                         incoming().projectId == existing().projectId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'memo']) &&
                          incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200 &&
                          incoming().url is string && incoming().url.size() > 0 && incoming().url.size() <= 2000 &&
                          (!('memo' in incoming()) || (incoming().memo is string && incoming().memo.size() <= 1000));
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
